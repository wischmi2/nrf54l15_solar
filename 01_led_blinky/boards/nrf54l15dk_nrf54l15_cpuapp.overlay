/*
 * Nordic_Solar — shared devicetree overlay for the nRF54L15 + nPM1300 board (v2)
 * Target: nrf54l15dk/nrf54l15/cpuapp
 *
 * This describes the nPM1300 PMIC as it is wired on your v2 board:
 *   - I2C @ 0x6B, 3.0 V bus (VDDIO = BUCK2)
 *   - BUCK1 = 1.8 V (RF antenna switch only), BUCK2 = 3.0 V (SoC + logic)
 *   - Charger fed by USB-C + solar diode-OR'd into VBUS/CHG_IN
 *   - NTC pin faked with a fixed 10 kOhm resistor (~25 C), no real thermistor
 *   - Status LED on nPM1300 LED0 (host-controlled)
 *
 * The SAME overlay is used by all four bring-up apps. Copy it into each app's
 * boards/ directory (it is already placed there).
 *
 * I2C (nRF54L15 QFN): SCL = pin 4 / P1.03, SDA = pin 5 / P1.04.
 * P1.03 is NFC2 by default — UICR nfct-pins-as-gpios is required or SCL
 * never leaves the pad. uart20 is disabled (DK uses P1.04 as UART TX).
 */

&uicr {
	nfct-pins-as-gpios;
};

&nfct {
	status = "disabled";
};

&pinctrl {
	i2c_pmic_default: i2c_pmic_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 4)>,    /* P1.04, QFN pin 5 */
				<NRF_PSEL(TWIM_SCL, 1, 3)>;    /* P1.03, QFN pin 4 */
			bias-pull-up;
		};
	};

	i2c_pmic_sleep: i2c_pmic_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 4)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
			low-power-enable;
		};
	};
};

/* DK uart20 uses P1.04 (our SDA). uart30 uses P0.00 (our PMIC_INT). */
&uart20 {
	status = "disabled";
};

&uart30 {
	status = "disabled";
};

&spi22 {
	status = "disabled";
};

/*
 * FM8625H antenna switch (VDD = BUCK1 / VOUT1 = 1.8 V):
 *   VCTL low  -> ANT to RF1 -> chip antenna (2450AT18A100E)
 *   VCTL high -> ANT to RF2 -> ECT818000500 connector
 * ANT_SEL = P0.01 (QFN pin 24). Hold low for the onboard antenna.
 */
&gpio0 {
	ant_sel_hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "ANT_SEL";
	};
};

/*
 * nRF54L15 DK board files enable the 32.768 kHz LFXO. This custom board
 * does not have that crystal, so GRTC init waits forever and main() never
 * runs. Use the internal LF RC instead.
 */
&lfxo {
	status = "disabled";
};

&i2c22 {
	status = "okay";
	pinctrl-0 = <&i2c_pmic_default>;
	pinctrl-1 = <&i2c_pmic_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;   /* 100 kHz; PMIC also supports 400 kHz */

	npm1300: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;

		/* nPM1300 GPIO0 (pin 7) -> PMIC_INT -> nRF54L15 P0.00 (QFN pin 23). */
		host-int-gpios = <&gpio0 0 0>;
		pmic-int-pin   = <0>;

		npm1300_gpio: gpio-controller {
			compatible = "nordic,npm1300-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <5>;
		};

		npm1300_regulators: regulators {
			compatible = "nordic,npm1300-regulator";

			/* BUCK1 = 1.8 V (RF antenna switch rail) — Config 1 sets this
			 * from the VSET resistors; declared here so it can be read back.
			 */
			npm1300_buck1: BUCK1 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
			};

			/* BUCK2 = 3.0 V (VDDIO — powers the SoC; do NOT turn this off) */
			npm1300_buck2: BUCK2 {
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* LDO1/LDO2 unused on this board */
			npm1300_ldo1: LDO1 {
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3300000>;
			};
			npm1300_ldo2: LDO2 {
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3300000>;
			};
		};

		npm1300_charger: charger {
			compatible = "nordic,npm1300-charger";

			/* --- LiPo charge profile (400 mAh cell) --- */
			term-microvolt = <4200000>;     /* 4.2 V CV termination */
			term-warm-microvolt = <4100000>;/* lower target when warm */
			current-microamp = <200000>;    /* 200 mA (~0.5C for 400 mAh) */
			term-current-percent = <10>;    /* stop at 10% of ICHG */

			/* --- Input current limit ---
			 * Default hardware limit is ~100 mA. Raise it so USB/solar can
			 * actually deliver charge current. 500 mA is safe for USB-C;
			 * for solar-only the SPV1040T just supplies what it can.
			 */
			vbus-limit-microamp = <500000>;

			/* --- Battery discharge current limit --- */
			dischg-limit-microamp = <1000000>;

			/* --- NTC / thermistor ---
			 * Your board fakes the NTC with a fixed 10k to GND (no real
			 * thermistor). A 10k/3380 config reads a static ~25 C, so
			 * charging never NTC-faults. WARNING: there is NO real battery
			 * temperature protection — see README before outdoor deployment.
			 */
			thermistor-ohms = <10000>;
			thermistor-beta = <3380>;

			/* Enable charging at boot. Comment out to leave the charger off
			 * and enable/observe behaviour purely from firmware.
			 */
			charging-enable;
		};

		/*
		 * nPM1300 LED driver. This registers ONE Zephyr LED device
		 * (nodelabel npm1300_leds); the three LEDs are addressed by index
		 * 0/1/2 through the LED API (e.g. led_on(dev, 0)). There are no
		 * child nodes.
		 *
		 * LED0 = board status LED (VSYS -> R14 -> nPM1300 pin 25).
		 * "host" so firmware turns it on only while actually charging
		 * (USB in). Unplug USB -> idle -> LED off, even if solar still
		 * ticks VBUS-present at ~4 V.
		 */
		npm1300_leds: leds {
			compatible = "nordic,npm1300-led";
			nordic,led0-mode = "host";
			nordic,led1-mode = "error";
			nordic,led2-mode = "host";
		};
	};
};
